# Required production settings
NODE_ENV=production
PORT=3001
PUBLIC_ORIGIN=https://kiddo.example.com
JWT_SECRET=replace-with-at-least-32-random-characters
POSTGRES_PASSWORD=replace-with-a-strong-password
DATABASE_URL=postgres://kiddo:replace-with-a-strong-password@db:5432/kiddo

# AI provider: auto | genx | openrouter
AI_PROVIDER=auto

# GenX (preferred when AI_PROVIDER=auto and key exists)
GENX_API_KEY=
GENX_BASE_URL=https://query.genx.sh
GENX_CHAT_MODEL=gpt-5.6-luna
GENX_IMAGE_MODEL=
GENX_MUSIC_MODEL=

# OpenRouter fallback / alternative
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_CHAT_MODEL=openai/gpt-5.3-chat
OPENROUTER_IMAGE_MODEL=openai/gpt-5.2

# Credits / safety defaults
STARTING_CREDITS=100
CHAT_CREDIT_COST=1
STORY_CREDIT_COST=3
IMAGE_CREDIT_COST=10
MUSIC_CREDIT_COST=15
DEFAULT_DAILY_MESSAGE_LIMIT=80

# Webdock / Caddy
DOMAIN=kiddo.example.com
